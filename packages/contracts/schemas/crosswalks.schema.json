{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrosswalkSnapshot",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "intersection_label",
      "leg_label",
      "lat",
      "lon",
      "year",
      "severity_score",
      "confidence_score",
      "rank_score",
      "reason_tags",
      "school_zone",
      "pavement_marking_311_count_since_2020",
      "matched_311_complaints",
      "image_url",
      "thumbnail_url",
      "google_maps_url",
      "model_score",
      "heuristic_score",
      "neighborhood",
      "neighborhood_id",
      "priority_reason",
      "pedestrian_crash_count",
      "borough",
      "top_features"
    ],
    "properties": {
      "id": { "type": "string" },
      "intersection_label": { "type": "string" },
      "leg_label": { "type": "string" },
      "lat": { "type": "number" },
      "lon": { "type": "number" },
      "year": { "const": 2024 },
      "severity_score": { "type": "number" },
      "confidence_score": { "type": "number" },
      "rank_score": { "type": "number" },
      "reason_tags": {
        "type": "array",
        "items": { "type": "string" }
      },
      "school_zone": { "type": "boolean" },
      "pavement_marking_311_count_since_2020": { "type": "number" },
      "matched_311_complaints": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["unique_key", "created_date", "descriptor", "incident_address", "url"],
          "properties": {
            "unique_key": { "type": "string" },
            "created_date": { "type": "string" },
            "descriptor": { "type": "string" },
            "incident_address": { "type": "string" },
            "url": { "type": "string" }
          }
        }
      },
      "image_url": { "type": "string" },
      "thumbnail_url": { "type": "string" },
      "google_maps_url": { "type": "string" },
      "model_score": { "type": "number" },
      "heuristic_score": { "type": "number" },
      "neighborhood": { "type": "string" },
      "neighborhood_id": { "type": "string" },
      "priority_reason": { "type": "string" },
      "pedestrian_crash_count": { "type": "number" },
      "borough": { "type": "string" },
      "paint_missing_ratio": { "type": ["number", "null"] },
      "stripe_break_ratio": { "type": ["number", "null"] },
      "contrast_score": { "type": ["number", "null"] },
      "occlusion_penalty": { "type": ["number", "null"] },
      "image_paint_score": { "type": ["number", "null"] },
      "urgency_score": { "type": "number" },
      "passed_visual_gate": { "type": "boolean" },
      "top_features": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "feature": { "type": "string" },
            "label": { "type": "string" },
            "contribution": { "type": "number" },
            "direction": { "type": "string" }
          }
        }
      }
    }
  }
}
